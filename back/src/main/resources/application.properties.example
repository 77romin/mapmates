# 이 파일을 application.properties로 복사해서 사용한다. (application.properties는 git에 올리지 않는다)
# 같은 이름의 환경변수가 있으면 환경변수가 우선한다. 예) db.url -> MAPMATES_DB_URL

db.url=jdbc:mysql://localhost:3306/mapmates?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
db.user=ssafy
db.password=ssafy

# 프론트를 dev-server.js(5500)로 따로 띄울 때 세션 쿠키를 허용할 출처. 쉼표로 구분.
cors.allowed-origins=http://localhost:5500,http://127.0.0.1:5500
