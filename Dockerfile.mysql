FROM mysql:8.0.46
COPY db/schema.sql /docker-entrypoint-initdb.d/01-schema.sql
COPY db/ref/SSAFY_TRIP_Dump.sql /tmp/tour.sql
RUN sed 's/USE ssafy_trip;/USE mapmates;/' /tmp/tour.sql > /docker-entrypoint-initdb.d/02-data.sql && rm /tmp/tour.sql
COPY db/init/03-clean.sql /docker-entrypoint-initdb.d/03-clean.sql
ARG SEED_DEMO=true
COPY db/seed.sql /tmp/seed.sql
RUN if [ "$SEED_DEMO" = "true" ]; then cp /tmp/seed.sql /docker-entrypoint-initdb.d/04-seed.sql; fi; rm /tmp/seed.sql
COPY db/migrations/*.sql /docker-entrypoint-initdb.d/
